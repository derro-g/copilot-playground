rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isTeacher() {
      return signedIn()
        && exists(/databases/$(database)/documents/teacherUsers/$(request.auth.uid));
    }

    function ownsSession(sessionId) {
      return isTeacher()
        && get(/databases/$(database)/documents/sessions/$(sessionId)).data.ownerUid == request.auth.uid;
    }

    function sessionIsOpen(sessionId) {
      return get(/databases/$(database)/documents/sessions/$(sessionId)).data.status == 'open';
    }

    match /teacherUsers/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }

    match /sessionCodes/{code} {
      allow read, write: if false;
    }

    match /joinRateLimits/{rateId} {
      allow read, write: if false;
    }

    match /tests/{testId} {
      allow get, list: if isTeacher() && resource.data.ownerUid == request.auth.uid;
      allow create: if isTeacher()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 100
        && request.resource.data.feedbackMode in ['immediate', 'end']
        && request.resource.data.speedBonus is bool
        && request.resource.data.noTimeLimit is bool;
      allow update: if isTeacher()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 100
        && request.resource.data.feedbackMode in ['immediate', 'end'];
      allow delete: if isTeacher() && resource.data.ownerUid == request.auth.uid;

      match /questions/{questionId} {
        allow read, create, update, delete: if isTeacher()
          && get(/databases/$(database)/documents/tests/$(testId)).data.ownerUid == request.auth.uid;
      }
    }

    match /sessions/{sessionId} {
      allow get, list: if isTeacher() && resource.data.ownerUid == request.auth.uid;
      allow create: if isTeacher()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.status in ['open', 'closed'];
      allow update: if isTeacher()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.status in ['open', 'closed']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
      allow delete: if isTeacher() && resource.data.ownerUid == request.auth.uid;

      match /publicQuestions/{questionId} {
        allow get, list: if ownsSession(sessionId);
        allow write: if false;
      }

      match /answerKeys/{questionId} {
        allow read, write: if false;
      }

      match /attempts/{attemptId} {
        allow create: if signedIn()
          && request.auth.token.firebase.sign_in_provider == 'anonymous'
          && attemptId == request.auth.uid
          && sessionIsOpen(sessionId)
          && request.resource.data.keys().hasOnly(['ownerUid', 'studentName', 'status', 'score', 'maxMarks', 'createdAt'])
          && request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.studentName is string
          && request.resource.data.studentName.size() > 0
          && request.resource.data.studentName.size() <= 60
          && request.resource.data.status == 'inProgress'
          && request.resource.data.score == 0
          && request.resource.data.maxMarks == get(/databases/$(database)/documents/sessions/$(sessionId)).data.maxMarks
          && request.resource.data.createdAt == request.time;
        allow get: if isTeacher() && ownsSession(sessionId);
        allow list: if isTeacher() && ownsSession(sessionId);
        allow update, delete: if isTeacher() && ownsSession(sessionId);

        match /responses/{questionId} {
          allow get, list: if isTeacher() && ownsSession(sessionId);
          allow write: if false;
        }
      }
    }
  }
}
